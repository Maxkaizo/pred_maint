FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

WORKDIR /app

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1

# Copy project files
COPY pyproject.toml uv.lock /app/

# Install dependencies (only what's needed for inference)
RUN uv sync --frozen --no-dev

# Copy application code
COPY . /app

EXPOSE 8000

# Use uv run to execute main.py from the correct environment
CMD ["uv", "run", "python", "inference_app/main.py"]
